# Keep secrets out of the Docker build
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# no copying dependencies into the image
node_modules
**/node_modules

# Exclude Git history
.git

# Exclude logs and local database files
*.log
backend/data/*.db
backend/data/*.db-*
foodhub-backup.db

# Exclude editor and operating system files
.vscode
.DS_Store
Thumbs.db
