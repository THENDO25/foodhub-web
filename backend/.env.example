# Copy this file to .env and fill in real values before running in anything
# other than a quick local test.

PORT=3000
NODE_ENV=development

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite file lives.
DB_PATH=./data/foodhub.db

# Seeded admin account (change the password before any real use).
ADMIN_EMAIL=admin@foodhub.com
ADMIN_PASSWORD=admin123

# Restrict to a specific origin in production, e.g. https://foodhub.example.com
CORS_ORIGIN=
