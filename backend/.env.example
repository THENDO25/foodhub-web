# Copy to backend/.env and replace every CHANGE_ME value. Never commit .env.
PORT=3000
NODE_ENV=production

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_generate_a_long_random_value

DB_PATH=./data/foodhub.db

# Used only when the admin account does not exist yet (fresh database).
ADMIN_EMAIL=admin@foodhub.com
ADMIN_PASSWORD=CHANGE_ME_choose_a_strong_password

# Only needed if the frontend is served from a DIFFERENT origin than the API.
# The default same-origin setup (Docker) does not need it. Comma separated.
CORS_ORIGIN=

# Set to true ONLY when HTTPS is terminated in front of the app (Caddy/nginx/ALB).
# Leave unset when testing over plain http (localhost or http://<server-ip>:3000):
# it enables upgrade-insecure-requests and the Secure cookie flag.
# FORCE_HTTPS=true
# COOKIE_SECURE=true
